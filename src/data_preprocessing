import pandas as pd
import numpy as np


def load_data(data_dir="data/raw"):
    """Load and combine the five supplementary datasets."""

    files = [
        "Supplementary data 1.csv",
        "Supplementary data 2.csv",
        "Supplementary data 3.csv",
        "Supplementary data 4.csv",
        "Supplementary data 5.csv",
    ]

    dataframes = []

    for file in files:
        path = f"{data_dir}/{file}"
        df = pd.read_csv(path)
        dataframes.append(df)

    df = pd.concat(dataframes, ignore_index=True)

    return df


def clean_data(df):
    """Clean and preprocess the ovarian cancer dataset."""

    df = df.copy()

    # Remove unnecessary columns
    df = df.drop(
        columns=[
            "Unnamed: 0",
            "SUBJECT_ID",
            "Biomarker",
            "Biomarker Name"
        ],
        errors="ignore"
    )

    # Clean columns
    for col in df.columns:

        df[col] = df[col].astype(str)

        df[col] = (
            df[col]
            .str.replace("\t", "", regex=False)
            .str.strip()
        )

        df[col] = df[col].replace(
            ["", "nan", "None"],
            np.nan
        )

        # Convert all columns except target to numeric
        if col != "TYPE":
            df[col] = pd.to_numeric(
                df[col],
                errors="coerce"
            )

    # Remove rows without target
    df = df.dropna(subset=["TYPE"])

    # Remove CA72-4 because of excessive missing values
    if "CA72-4" in df.columns:
        df = df.drop(columns=["CA72-4"])

    # Fill numerical missing values with median
    df = df.fillna(
        df.median(numeric_only=True)
    )

    # Convert target
    df["TYPE"] = pd.to_numeric(
        df["TYPE"],
        errors="coerce"
    )

    df["TYPE"] = df["TYPE"].astype(int)

    return df


def prepare_data(data_dir="data/raw"):
    """Complete data preparation pipeline."""

    df = load_data(data_dir)
    df = clean_data(df)

    return df


if __name__ == "__main__":

    df = prepare_data()

    print("Data shape:", df.shape)
    print("\nClass distribution:")
    print(df["TYPE"].value_counts())

    df.to_csv(
        "data/processed/data.csv",
        index=False
    )

    print("\nProcessed dataset saved.")
